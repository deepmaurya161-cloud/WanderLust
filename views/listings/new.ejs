<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">

<br>
<h3>Create a New Listing</h3>

<form method="POST" action="/listings" novalidate 
class="needs-validation" enctype="multipart/form-data">

  <div class="mb-3">
    <label class="form-label">Title</label>
    <input name="listing[title]" type="text" class="form-control" placeholder="Add a Catchy Title" required>
    <div class="valid-feedback">Title looks good!</div>
  </div>

  <div class="mb-3">
    <label class="form-label">Description</label>
    <textarea name="listing[description]" class="form-control" required></textarea>
    <div class="invalid-feedback">Please enter a short description.</div>
  </div>

  <div class="mb-3">
    <label class="form-label">Upload Listing Image</label>
    <input name="listing[image]" type="file" class="form-control" >
    required
  </div>

  <div class="row">
    <div class="mb-3 col-md-4">
    <label class="form-label">Price</label>
    <input name="listing[price]" type="number" class="form-control" placeholder="1200" required>
      <div class="invalid-feedback">Price Should be valid!</div>
  </div>

  <div class="mb-3 col-md-8">
    <label class="form-label">Country</label>
    <input name="listing[country]" type="text" class="form-control" placeholder="India" required>
    <div class="invalid-feedback">Country name should be valid!</div>
  </div>
  </div>
  

  <div class="mb-3">
    <label class="form-label">Location</label>
    <input name="listing[location]" type="text" class="form-control" placeholder="Vadodara, Gujarat" required>
    <div class="invalid-feedback">Location should be wriiten.</div>
  </div>

  <button class="btn btn-dark add-btn mt-3">Add</button>
  </form>
  </div>
</div>

